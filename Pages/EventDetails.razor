@page "/events/{id:int}"
@inject EventEase.Services.MockEventService EventService
@using EventEase.Models

<h3>Event Details</h3>

@if (eventItem == null)
{
    <h3>Event Not Found</h3>
    <p>The event you are trying to view does not exist.</p>

    <a class="btn btn-primary" href="/events">Back to Events</a>
}
else
{
    <h4>@eventItem.Name</h4>
    <p><strong>Date:</strong> @eventItem.Date.ToLongDateString()</p>
    <p><strong>Location:</strong> @eventItem.Location</p>
    <p>@eventItem.Description</p>

    <a class="btn btn-success" href="/events/@eventItem.Id/register">Register</a>
}

<a class="btn btn-secondary" href="/events/@eventItem?.Id/attendance">
    View Attendance
</a>


@code {
    [Parameter] public int Id { get; set; }
    private EventItem? eventItem;

    protected override void OnParametersSet()
    {
        eventItem = EventService.GetEvent(Id);
    }
}
